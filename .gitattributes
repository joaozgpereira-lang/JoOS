# Force LF for all shell/conf files so CRLF never breaks them (Windows checkouts)
* text=auto
*.sh text eol=lf
*.conf text eol=lf
*.rasi text eol=lf
*.toml text eol=lf
*.jsonc text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.zshrc text eol=lf
*.zlogin text eol=lf
# Windows batch keeps CRLF
*.bat text eol=crlf
# Binary
*.png binary
*.iso binary